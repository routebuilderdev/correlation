# --- NEAR AI Cloud ---
NEARAI_API_KEY=
# Must be a DIRECT model endpoint (https://<model-slug>.completions.near.ai/v1).
# The cloud-api gateway signs "<req>:<resp>" with signature_kind=gateway, which the
# contract rejects as E07; direct model endpoints sign "<model>:<req>:<resp>" as provider_tee.
NEARAI_BASE_URL=https://glm-5-3-flash.completions.near.ai/v1
NEARAI_MODEL=z-ai/glm-5.3-flash
NEARAI_MODEL_FALLBACK=Qwen/Qwen3.8-27B
NEARAI_PROVIDER=near
NEARAI_SIGNING_ALGO=ecdsa

# --- chain ---
NEAR_NETWORK=testnet
NEAR_RPC_URL=https://rpc.testnet.near.org
CONTRACT_ID=correlation.testnet
EVAL_ACCOUNT=eval.correlation.testnet
EVAL_PRIVATE_KEY=
BUYER_ACCOUNT=buyer.correlation.testnet
BUYER_PRIVATE_KEY=
LP_ACCOUNT=lp.correlation.testnet
LP_PRIVATE_KEY=

# --- policy defaults ---
AGENT_COUNT=20
TRIGGER_BPS=2500
MIN_RECEIPTS=16
WINDOW_MINUTES=60
LIMIT_YOCTO=10000000000000000000000000
PREMIUM_YOCTO=1000000000000000000000000

# --- api ---
PORT=8787
